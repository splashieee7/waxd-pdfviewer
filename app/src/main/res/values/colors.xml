<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Waxd terminal/ops-console theme. Same four hex values as every other
        waxd reskin (see waxd-launcher's colors.xml); applied here via
        explicit Material3 color role attributes in styles.xml, since this
        app has no shared "commons" library to override.
    -->
    <color name="waxd_background">#0A0C0A</color>
    <color name="waxd_text">#D8F5E0</color>
    <color name="waxd_primary">#2E9E5B</color>
    <color name="waxd_accent">#4CFF8B</color>
</resources>
